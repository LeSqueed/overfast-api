# Container settings
APP_VOLUME_PATH=
APP_PORT=80

# Application settings
APP_BASE_URL=https://overfast-api.tekrop.fr
LOG_LEVEL=info
STATUS_PAGE_URL=
PROFILER=
NEW_ROUTE_PATH=

# Rate limiting
# Comma-separated CIDRs of upstream proxies allowed to set X-Forwarded-For
# (e.g. "10.0.0.0/8,192.168.0.0/16"). Leave empty when nginx is exposed
# directly, otherwise clients can spoof the header and bypass rate limiting.
# List only the proxies you actually run: 0.0.0.0/0 trusts every client and
# restores the bypass.
TRUSTED_PROXY_CIDRS=
RETRY_AFTER_HEADER=Retry-After
RATE_LIMIT_PER_SECOND_PER_IP=30
RATE_LIMIT_PER_IP_BURST=5
MAX_CONNECTIONS_PER_IP=10

# Adaptive throttling (TCP Slow Start + AIMD for Blizzard requests)
THROTTLE_ENABLED=true
THROTTLE_START_DELAY=2.0
THROTTLE_MIN_DELAY=0.1
THROTTLE_MAX_DELAY=30.0
THROTTLE_SLOW_START_N_SUCCESSES=10
THROTTLE_AIMD_N_SUCCESSES=20
THROTTLE_AIMD_DELTA=0.05
THROTTLE_PENALTY_DELAY=10.0
THROTTLE_PENALTY_DURATION=60

# Background worker
WORKER_MAX_CONCURRENT_JOBS=10
WORKER_JOB_TIMEOUT=300

# Nginx tuning
# Number of worker processes (0 = auto-detect CPU cores, or set explicit number like 4, 8, etc.)
NGINX_WORKER_PROCESSES=0
NGINX_WORKER_CONNECTIONS=1024
NGINX_MULTI_ACCEPT=true

# Valkey
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_MEMORY_LIMIT=1gb

# Persistent Storage (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=overfast
POSTGRES_USER=overfast
# REQUIRED: set a strong password, do not leave empty
POSTGRES_PASSWORD=
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10

# Unknown players cache system
UNKNOWN_PLAYERS_CACHE_ENABLED=true
UNKNOWN_PLAYER_COOLDOWN_KEY_PREFIX=unknown-player:cooldown
UNKNOWN_PLAYER_INITIAL_RETRY=600
UNKNOWN_PLAYER_RETRY_MULTIPLIER=3
UNKNOWN_PLAYER_MAX_RETRY=21600
UNKNOWN_PLAYER_MIN_RETENTION_COUNT=5

# Cache configuration
CACHE_TTL_HEADER=X-Cache-TTL
HEROES_PATH_CACHE_TIMEOUT=86400
HERO_PATH_CACHE_TIMEOUT=86400
CSV_CACHE_TIMEOUT=86400
CAREER_PATH_CACHE_TIMEOUT=600
SEARCH_ACCOUNT_PATH_CACHE_TIMEOUT=600
HERO_STATS_CACHE_TIMEOUT=3600
# Hero stats history/dates endpoints. Their data only changes when the daily
# snapshot cron runs, so they are cached far longer than the live stats above.
# A quarter of the snapshot period bounds how long a new snapshot stays hidden.
HERO_STATS_HISTORY_CACHE_TIMEOUT=21600  # 6 hours
PLAYER_PROFILE_MAX_AGE=604800

# Hero stats snapshots (historical per-map/per-tier pickrate & winrate)
HERO_STATS_SNAPSHOT_ENABLED=true
# Cron expression for the snapshot task (UTC).
# The run walks the full platform x region x map x division x hero grid, so it
# is a large burst of throttled Blizzard requests rather than a single call.
# 11:00 UTC puts that burst in European daytime, which is a deliberate
# tradeoff: it overlaps peak API traffic (the throttle backs both off together)
# but keeps the run inside working hours, so a failure is noticed and can be
# re-run the same day instead of silently losing a day of history that can
# never be scraped again. Move it if your own traffic profile differs.
HERO_STATS_SNAPSHOT_CRON=0 11 * * *
# Retention window in seconds before old snapshots are pruned (0 = never).
# Disabled by default: snapshot history is meant to accumulate forever, and a
# pruned day cannot be re-scraped.
# UPGRADING: this file's default does NOT reach an existing deployment — .env
# overrides it. An instance still carrying a non-zero value (e.g. 31536000)
# keeps deleting old history. Set it to 0 there explicitly.
HERO_STATS_SNAPSHOT_MAX_AGE=0

# SWR staleness thresholds
HEROES_STALENESS_THRESHOLD=86400  # 24 hours
MAPS_STALENESS_THRESHOLD=86400
GAMEMODES_STALENESS_THRESHOLD=86400
ROLES_STALENESS_THRESHOLD=86400
PLAYER_STALENESS_THRESHOLD=3600  # 1 hour
STALE_CACHE_TIMEOUT=60

# Critical error Discord webhook
DISCORD_WEBHOOK_ENABLED=false
DISCORD_WEBHOOK_URL=""
DISCORD_MESSAGE_ON_RATE_LIMIT=false

# Monitoring (optional)
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
PROMETHEUS_NGINX_PORT=9145
PROMETHEUS_WORKER_PORT=9091
VALKEY_EXPORTER_PORT=9121
POSTGRES_EXPORTER_PORT=9187

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# REQUIRED if using the grafana profile: set a strong password, do not leave empty
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SERVER_ROOT_URL=%(protocol)s://%(domain)s:%(http_port)s/
